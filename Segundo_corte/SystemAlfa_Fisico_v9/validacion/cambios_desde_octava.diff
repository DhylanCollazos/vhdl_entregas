+            when 9=>valor_visor<=to_integer(unsigned(rojo));ver_hex<='1';
+            when 10=>valor_visor<=to_integer(unsigned(verde));ver_hex<='1';
+            when 11=>valor_visor<=to_integer(unsigned(azul));ver_hex<='1';
+            when others=>null;
