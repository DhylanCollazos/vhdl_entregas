+    U_VISOR:entity work.visor_ajuste port map(CLOCK_50,valor_visor,ver_hex,a0,a1,a2,a3);
+    HEX0<=a0 when modo_ajuste='1' else c0; HEX1<=a1 when modo_ajuste='1' else c1;
